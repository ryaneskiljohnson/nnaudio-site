{
  "git": {
    "deploymentEnabled": {
      "main": true
    }
  },
  "crons": [
    {
      "path": "/api/review-followups/process",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/admin/growth-ops/process-actions",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/email-campaigns/process-scheduled",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/automation-engine/process-jobs",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/automation-engine/process-events",
      "schedule": "* * * * *"
    }
  ],
  "functions": {
    "app/api/admin/growth-ops/process-actions/route.ts": {
      "maxDuration": 60
    }
  },
  "buildCommand": "bun run verify:barrels && bun run build",
  "installCommand": "bun install --frozen-lockfile",
  "framework": "nextjs"
}

