{
  "crons": [
    {
      "path": "/api/email-campaigns/process-scheduled",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/admin/growth-ops/process-actions",
      "schedule": "* * * * *"
    }
  ],
  "functions": {
    "app/api/email-campaigns/process-scheduled/route.ts": {
      "maxDuration": 60
    },
    "app/api/email-campaigns/send/route.ts": {
      "maxDuration": 60
    },
    "app/api/email-campaigns/campaigns/route.ts": {
      "maxDuration": 30
    },
    "app/api/admin/growth-ops/process-actions/route.ts": {
      "maxDuration": 30
    }
  }
} 