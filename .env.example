NEXT_PUBLIC_SITE_URL=http://localhost:3000

NEXT_PUBLIC_SUPABASE_URL=https://<project-id>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Amazon SES (for support@nnaud.io)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
SENDER_EMAIL=support@nnaud.io
SENDER_NAME=NNAudio Support
# SES_CONFIGURATION_SET=nnaud-email-events  # Optional: create in SES console for tracking

NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_12345
STRIPE_SECRET_KEY=sk_12345
STRIPE_WEBHOOK_SECRET=whsec_12345
STRIPE_PRICE_ID_MONTHLY=price_12345
STRIPE_PRICE_ID_ANNUAL=price_67890
STRIPE_PRICE_ID_LIFETIME=price_24680

# Meta (Facebook/Instagram) Ads – Pixel + Conversions API (NNAudio)
# NNAudio Pixel ID: 1072073301239581 (Events Manager → NNAudio business → NNAUDIO dataset)
# Token: Events Manager → NNAudio pixel → Settings → Conversions API → Generate access token
NEXT_PUBLIC_META_PIXEL_ID=1072073301239581
META_CONVERSIONS_API_TOKEN=

# Facebook Ad Manager (in-app admin) – OAuth for campaign management
# Create app at developers.facebook.com → Business app → add Marketing API → set redirect URI to .../api/facebook-ads/callback
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
# Optional: force a specific ad account; if unset, first account is used after Connect
# FACEBOOK_AD_ACCOUNT_ID=
# Required for creating ads with link creative: your Facebook Page ID (from Page settings)
# META_PAGE_ID=